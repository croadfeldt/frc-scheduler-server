# OpenShift secrets template.
# Copy to 01-secrets.yaml, fill in values, then apply:
#   oc apply -f openshift/01-secrets.yaml
# Then IMMEDIATELY delete: rm openshift/01-secrets.yaml
# NEVER commit 01-secrets.yaml to git.
#
# For detailed integration setup instructions (where to get each token,
# what each integration does, what happens when it's missing), see:
#   docs/INTEGRATIONS.md
#
# NOTE: DATABASE_URL must be kept in sync with POSTGRES_* values above it.
# It is stored explicitly because Kubernetes $(VAR) substitution does not
# work when the referenced variable comes from valueFrom: secretKeyRef.
---
apiVersion: v1
kind: Secret
metadata:
  name: frc-db-secret
  namespace: NAMESPACE_PLACEHOLDER
type: Opaque
stringData:
  POSTGRES_USER:     frc
  POSTGRES_PASSWORD: CHANGE_ME_STRONG_PASSWORD
  POSTGRES_DB:       frc_scheduler
  DATABASE_URL:      "postgresql+asyncpg://frc:CHANGE_ME_STRONG_PASSWORD@frc-postgres:5432/frc_scheduler"
---
apiVersion: v1
kind: Secret
metadata:
  name: frc-app-secret
  namespace: NAMESPACE_PLACEHOLDER
type: Opaque
stringData:
  # ── External integrations ──────────────────────────────────────────────
  # See docs/INTEGRATIONS.md for what each does, where to get tokens, and
  # how to verify the integration is working.

  # The Blue Alliance (TBA) — primary source of FRC event/match data.
  # Required for: event picker, team imports, live data, source detection.
  # Get your key at: https://www.thebluealliance.com/account → Read API
  TBA_API_KEY:           YOUR_TBA_API_KEY

  # FRC Events API — official FIRST API, used as fallback when TBA doesn't
  # have an event yet. Optional. Apply at:
  # https://frc-events.firstinspires.org/services/API
  FRC_EVENTS_USERNAME:   YOUR_FRC_EVENTS_USERNAME
  FRC_EVENTS_TOKEN:      YOUR_FRC_EVENTS_TOKEN

  # Nexus for FRC — two integration modes (you can use either or both).
  # Setup at https://frc.nexus/en/api → log in, choose your event(s).
  #
  # ── Push mode (webhooks) ──
  # Nexus POSTs match-status updates to a URL you own. To enable:
  #   1. On Nexus's API page, click "Add a webhook URL" and enter:
  #        https://YOUR_SCHEDULER_HOST/api/webhooks/nexus
  #   2. Nexus generates a token and displays it to you
  #   3. Paste that token below as NEXUS_WEBHOOK_TOKEN
  #   4. Nexus sends a verification POST to your URL (must return 200 OK)
  #      — our endpoint handles this automatically.
  #   5. After verification, you'll receive POSTs whenever match status changes.
  # Nexus sends the token as the `Nexus-Token` request header on every call.
  # If the env var is unset, our webhook endpoint accepts unauthenticated
  # POSTs (acceptable for local dev only — set this in production).
  NEXUS_WEBHOOK_TOKEN:   YOUR_NEXUS_WEBHOOK_TOKEN

  # ── Pull mode (HTTP GET) ──
  # We periodically GET Nexus's pull endpoint to fetch the latest event
  # snapshot. Useful when our service can't accept inbound webhooks
  # (NAT, firewall, no public hostname) or as a fallback when push fails.
  # Setup:
  #   1. On Nexus's API page, copy your "API key" (under the Pull section)
  #   2. Paste it below as NEXUS_API_KEY
  #   3. We send it as the `Nexus-Api-Key` header on each request.
  # The pull URL is shown next to your API key on Nexus's API page; we use
  # it automatically. If unset, pull mode is disabled.
  NEXUS_API_KEY:         YOUR_NEXUS_API_KEY

  # LLM endpoint for PDF schedule import.
  #
  # Required for: the "Import schedule from PDF" button in the editor.
  # When unset, the button is hidden and only TBA/manual paths work.
  #
  # The scheduler talks to ANY OpenAI-compatible endpoint. It doesn't
  # care what's behind the URL — pick whatever fits your situation.
  # Image-based PDFs (scanned schedules, image-only events) need a
  # vision-capable model; text-only models work for text-extracted PDFs
  # but won't handle the vision-fallback path.
  #
  # Examples (uncomment the one you want, fill in real values):
  #
  #   # Self-hosted vLLM via the vllm-inference repo:
  #   LLM_ENDPOINT: "http://vllm-qwen25-vl-7b.vllm-inference.svc.cluster.local:8000/v1"
  #   LLM_MODEL:    "qwen2.5-vl-7b"
  #   LLM_API_KEY:  ""
  #
  #   # OpenShift AI InferenceService:
  #   LLM_ENDPOINT: "https://qwen25-vl-7b-vllm-inference.apps.<cluster>.<domain>/v1"
  #   LLM_MODEL:    "qwen25-vl-7b"
  #   LLM_API_KEY:  "<service-account token if auth enabled>"
  #
  #   # Anthropic (verify OpenAI-compat layer works for your model):
  #   LLM_ENDPOINT: "https://api.anthropic.com/v1"
  #   LLM_MODEL:    "claude-sonnet-4-5"
  #   LLM_API_KEY:  "sk-ant-..."
  #
  #   # OpenAI:
  #   LLM_ENDPOINT: "https://api.openai.com/v1"
  #   LLM_MODEL:    "gpt-4o"
  #   LLM_API_KEY:  "sk-..."
  #
  # Privacy: PDFs are sent only to the configured endpoint. We don't log
  # PDF content; only file size and SHA-256 hash are recorded for caching.
  #
  # Architecture note: this used to be split into LLM_ENDPOINT (text-only)
  # and LLM_VISION_ENDPOINT (vision). They were consolidated into one
  # endpoint because vision-capable models handle text-only prompts fine
  # and are typically faster than larger text-only models for short
  # structured-extraction tasks. The legacy LLM_VISION_* vars are still
  # honored if LLM_ENDPOINT is unset, for migration compatibility.
  LLM_ENDPOINT:          ""    # base URL ending in /v1
  LLM_MODEL:             ""    # model id the endpoint expects
  LLM_API_KEY:           ""    # leave empty for endpoints without auth

  # Statbotics: no configuration needed — public read-only API.
  # The /api/statbotics/* endpoints work out of the box.

  # Deep-links to TBA, Statbotics, FRC Events from per-team and per-event
  # panels: no configuration needed — pure URL construction from event key.
---
apiVersion: v1
kind: Secret
metadata:
  name: frc-auth-secret
  namespace: NAMESPACE_PLACEHOLDER
type: Opaque
stringData:
  JWT_SECRET:            CHANGE_ME_RUN_openssl_rand_-hex_32
  BASE_URL:              https://YOUR_HOSTNAME
  GOOGLE_CLIENT_ID:      ""
  GOOGLE_CLIENT_SECRET:  ""
  APPLE_CLIENT_ID:       ""
  APPLE_TEAM_ID:         ""
  APPLE_KEY_ID:          ""
  APPLE_PRIVATE_KEY:     ""

  # Admin allow-list — comma-separated email addresses promoted
  # to is_admin=true at login time. Used to bootstrap administrator
  # access before RBAC ships. Interim mechanism per
  # docs/SCHEDULE_LIFECYCLE.md Phase E. Leave empty to disable
  # auto-promotion (admins can still be set via DB UPDATE).
  # Example: "alice@example.com,bob@example.com"
  ADMIN_EMAILS:          ""
