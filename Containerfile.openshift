# OpenShift-specific build file. Uses quay.io/sclorg to avoid Docker Hub rate limits
# in OpenShift build pods. Referenced by openshift/03-buildconfig.yaml.
#
# NOT intended for local Docker/Podman use — use Containerfile instead.

FROM quay.io/sclorg/python-312-c10s:latest

USER 0

WORKDIR /app

# System deps:
#   - tesseract: PDF import OCR strategy (image-based PDFs)
#   - pango / harfbuzz / fontconfig / dejavu fonts: WeasyPrint runtime
#     deps for HTML→PDF rendering. WeasyPrint dropped Cairo as of v60+
#     so we don't need cairo-devel. We do need pango, harfbuzz, and a
#     fontconfig-managed font set; dejavu-sans-fonts gives us a
#     reasonable Helvetica-equivalent that's always available.
# Modern tesseract on EL9+/CS10+ bundles English training data directly,
# but install tesseract-langpack-eng best-effort to handle older mirrors.
RUN dnf install -y --nodocs \
        gcc libpq-devel shadow-utils \
        tesseract \
        pango harfbuzz \
        fontconfig dejavu-sans-fonts dejavu-serif-fonts dejavu-sans-mono-fonts \
    && dnf install -y --nodocs tesseract-langpack-eng || true \
    && dnf clean all \
    && tesseract --list-langs 2>&1 | grep -q '^eng$' \
        || { echo "ERROR: tesseract installed but eng training data missing"; exit 1; } \
    && fc-list | head -3 \
        || { echo "ERROR: fontconfig installed but no fonts available"; exit 1; }

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN chgrp -R 0 /app && chmod -R g=u /app

ENV CPU_WORKERS=0
ENV PYTHONUNBUFFERED=1
ENV APP_PORT=8080
ENV PUID=1000
ENV PGID=1000

EXPOSE ${APP_PORT}

ENTRYPOINT ["/entrypoint.sh"]
